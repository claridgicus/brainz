{
  // Brainz marketing site — static assets only, no Worker code.
  // Deploy: `npm run deploy` from apps/marketing (wrangler login first).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brainz-marketing",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./build",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    // www.brownmatter.ai -> brownmatter.ai is configured account-side
    // (Cloudflare redirect rule / Bulk Redirects), not in this config.
    { "pattern": "brownmatter.ai", "custom_domain": true }
  ]
}
