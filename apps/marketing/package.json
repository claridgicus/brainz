{
  "name": "brainz-marketing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Marketing site for Brainz (brownmatter.ai) — static SvelteKit, deployed to Cloudflare Workers static assets.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/generate-sitemap.mjs",
    "preview": "wrangler dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node scripts/check-build.mjs",
    "predeploy": "node ../../scripts/test-all.mjs --scope marketing",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "svelte": "^5.35.0",
    "svelte-check": "^4.2.0",
    "typescript": "^5.5.0",
    "vite": "^7.0.0",
    "wrangler": "^4.24.0"
  }
}
