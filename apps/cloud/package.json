{
  "name": "@brainz/cloud",
  "version": "0.1.0",
  "private": true,
  "description": "Brainz Cloud: SvelteKit app deployed as one Cloudflare Worker — dashboard, REST API, and remote MCP over per-vault Durable Objects.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite-only": "vite dev",
    "build": "vite build && node scripts/patch-worker.mjs",
    "preview": "npm run build && wrangler dev",
    "preview:local": "npm run build && wrangler dev --local",
    "predeploy": "node ../../scripts/test-all.mjs",
    "deploy": "npm run build && wrangler deploy && node scripts/publish-registry.mjs",
    "registry:publish": "node scripts/publish-registry.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply brainz --local",
    "db:migrate:remote": "wrangler d1 migrations apply brainz --remote",
    "test": "svelte-kit sync && vitest run",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@brainz/contracts": "*",
    "@brainz/engine": "*",
    "@hono/mcp": "^0.1.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "better-auth": "^1.3.0",
    "d3-force": "^3.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0",
    "marked": "^13.0.3",
    "mimetext": "^3.0.28",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250620.0",
    "@sveltejs/adapter-cloudflare": "^7.0.0",
    "@sveltejs/kit": "^2.21.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20.17.0",
    "drizzle-kit": "^0.31.0",
    "svelte": "^5.30.0",
    "svelte-check": "^4.2.0",
    "typescript": "~5.5.4",
    "vite": "^6.3.0",
    "vitest": "^2.1.9",
    "wrangler": "^4.20.0"
  }
}
