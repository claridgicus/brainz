# Copy to .dev.vars (gitignored) for local development.
# Production values are set with `wrangler secret put <NAME>`.
BETTER_AUTH_SECRET=dev-insecure-secret-change-me
# vite dev serves on 5173; `npm run preview` (wrangler dev) serves on 8787.
# BETTER_AUTH_URL is optional locally — Better Auth infers the base URL from
# the request when unset, and both localhost origins are trusted.
BETTER_AUTH_URL=http://localhost:5173

# Optional: GitHub OAuth is enabled only when both values are present.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Dreaming: bring-your-own LLM keys are AES-GCM encrypted at rest with a key
# derived from this secret. Production: `wrangler secret put BYOK_ENCRYPTION_KEY`
# (e.g. `openssl rand -base64 32`). Changing it makes stored keys unreadable.
BYOK_ENCRYPTION_KEY=dev-insecure-byok-key-change-me
# Optional overrides (defaults live in wrangler.jsonc vars):
# DREAM_DAILY_USD_PER_ACCOUNT=1
# DREAMING_AI_DISABLED=workers-ai
# MAX_VAULTS_PER_USER=20
# VAULT_CREATE_RATE_LIMIT=10

# Optional: OpenAI plugin-portal domain verification. The portal shows the token
# at connect time; it is served verbatim at /.well-known/openai-apps-challenge
# (404 while unset). Production: `wrangler secret put OPENAI_APPS_CHALLENGE`.
# OPENAI_APPS_CHALLENGE=
