// Brainz Cloud — ONE Cloudflare Worker: SvelteKit UI + REST API + remote MCP.
// Deploy-ready except the account-specific D1 database_id (see below).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brainz-cloud",
  // adapter-cloudflare emits the compiled SvelteKit worker HERE (it writes to
  // whatever `main` points at). The npm `build` script then appends the
  // VaultDO Durable Object export to it (scripts/patch-worker.mjs) because
  // the adapter cannot add named exports itself and DO classes must be
  // exported from the Worker entrypoint. `npm run build` must run before
  // wrangler dev/deploy (the `preview` and `deploy` scripts do this).
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-06-01",
  // nodejs_compat is required: @brainz/engine's gray-matter touches Buffer.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  // Production dashboard + API + MCP host.
  "routes": [{ "pattern": "brainz.brownmatter.ai", "custom_domain": true }],
  // D1 is the shared control plane (auth, vault registry, API keys).
  // Create it with: wrangler d1 create brainz
  // …then paste the returned database_id here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brainz",
      "database_id": "c4a7ad9d-89c5-41b8-a7f9-a818a0e5324e",
      "migrations_dir": "drizzle"
    }
  ],
  // One Durable Object per vault; vault content lives in DO SQLite storage.
  "durable_objects": {
    "bindings": [{ "name": "VAULT_DO", "class_name": "VaultDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VaultDO"] }],
  // Workers AI: embeddings via @cf/baai/bge-base-en-v1.5 (768-dim).
  "ai": { "binding": "AI" },
  // Outbound email (magic-link sign-in) via Cloudflare's Email Service.
  // Deploy-day: onboard brownmatter.ai for Email Sending in the Cloudflare
  // dashboard (auto-adds MX/SPF/DKIM/DMARC) so no-reply@brownmatter.ai can
  // send. Absent locally → the mailer falls back to DevMailer (logs the link).
  // See README-CLOUD "Deploy runbook → email".
  "send_email": [{ "name": "SEND_EMAIL" }],
  // Dreaming spend controls (SPEC-CLOUD "Dreaming → Spend controls"):
  // USD per account per UTC day for operator-paid Workers AI dreams. The kill
  // switch lives in D1 (control_flag) — set DREAMING_AI_DISABLED here
  // ("workers-ai" | "all") only to force it from config. BYOK_ENCRYPTION_KEY
  // is a secret: wrangler secret put BYOK_ENCRYPTION_KEY.
  // Vault creation limits (SPEC-CLOUD "Creating a vault over MCP"): most
  // vaults one account owns, and most it creates per rolling hour. They apply
  // to POST /api/vaults, the consent page and the MCP create_vault tool.
  "vars": {
    "DREAM_DAILY_USD_PER_ACCOUNT": "1",
    "MAX_VAULTS_PER_USER": "20",
    "VAULT_CREATE_RATE_LIMIT": "10",
    // The "Support" vault (slug support, owned by James); see the support
    // inbox note below.
    "SUPPORT_VAULT_ID": "969ff944-48cb-4721-813b-48f65ab6e7d8"
  },
  // Daily housekeeping (src/lib/server/scheduled.ts): purges expired/revoked
  // OAuth codes, tokens and grants and idle DCR clients. The `scheduled`
  // handler is attached by scripts/patch-worker.mjs.
  "triggers": { "crons": ["23 4 * * *"] },
  // Support inbox (SPEC-CLOUD "Support inbox"): Email Routing delivers
  // support@brownmatter.ai to this Worker's `email` handler (attached by
  // scripts/patch-worker.mjs). SUPPORT_VAULT_ID in "vars" is the support vault's
  // id (without it every message is forwarded to SUPPORT_ESCALATE_TO, default
  // james@plutocracy.io). SUPPORT_AUTOSEND_CATEGORIES stays unset
  // (agents only draft) until James enables "howto". Optional R2 for raw mail
  // + attachments: wrangler r2 bucket create brainz-support-mail, then add
  //   "r2_buckets": [{ "binding": "SUPPORT_MAIL", "bucket_name": "brainz-support-mail" }]
  "observability": { "enabled": true }
}
