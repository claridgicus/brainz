{
  "name": "brainz-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:all": "node scripts/test-all.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
