{
  "name": "brainz-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "demos"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present && npm run test:integrations",
    "test:all": "node scripts/test-all.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:integrations": "node --test integrations/claude-code/brainz-orchestrate/test/brainz-orch.test.mjs",
    "demos:record": "npm run record -w @brainz/demos --",
    "demos:check": "npm run check -w @brainz/demos --",
    "demos:stack": "npm run stack -w @brainz/demos --"
  }
}
