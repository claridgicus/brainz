{
  "name": "@brainz/demos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Screencast demos of Brainz Cloud, recorded by Playwright against a local compose stack and rendered Screen Studio style for the marketing site.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "record": "tsx src/cli.ts record",
    "check": "tsx src/cli.ts check",
    "stack": "tsx src/cli.ts stack"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "playwright": "^1.56.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "~5.5.4",
    "vitest": "^2.1.9"
  }
}
